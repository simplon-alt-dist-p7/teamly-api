// generator client {
//   provider = "prisma-client"
//   output   = "../generated/prisma"
// }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EMPLOYEE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String
  role             Role
  employee         Employee?
  createdAt        DateTime     @default(now())
  ownedRestaurants Restaurant[]
}

model Employee {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  firstName     String
  lastName      String
  shifts        Shift[]
  leaveRequests LeaveRequest[]
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
}

model Shift {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  startTime  DateTime
  endTime    DateTime
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
}

model Restaurant {
  id        String     @id @default(uuid())
  name      String
  employees Employee[]
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id])
  // éventuellement owners via UserRestaurant / Membership
  createdAt DateTime   @default(now())
}
